ARG MAVEN_VERSION=3.10.1
ARG JAVA_VERSION=25
FROM maven:${MAVEN_VERSION}-eclipse-temurin-${JAVA_VERSION}

ARG REST_ASSURED_VERSION=6.3.0
ARG OPENAPI_REQUEST_VALIDATOR_VERSION=3.0.0
ARG JUNIT_VERSION=6.1.3
ARG MAVEN_SUREFIRE_VERSION=3.6.1
ENV REST_ASSURED_VERSION=${REST_ASSURED_VERSION} \
    OPENAPI_REQUEST_VALIDATOR_VERSION=${OPENAPI_REQUEST_VALIDATOR_VERSION} \
    JUNIT_VERSION=${JUNIT_VERSION} \
    MAVEN_SUREFIRE_VERSION=${MAVEN_SUREFIRE_VERSION}
WORKDIR /workspace
COPY pom.xml .
COPY src ./src
CMD ["mvn", "-B", "test"]
