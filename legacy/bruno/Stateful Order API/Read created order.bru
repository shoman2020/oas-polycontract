get {
  url: {{orderBaseUrl}}/orders/{{orderId}}
  body: none
  auth: none
}

tests {
  test("order is readable in created state", () => {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("created");
  });
}
