meta {
  name: Product health
  type: http
  seq: 1
}

get {
  url: {{productBaseUrl}}/healthz
  body: none
  auth: none
}

tests {
  test("health responds with 200", () => {
    expect(res.getStatus()).to.equal(200);
  });

  test("health response has a string status", () => {
    expect(res.getBody().status).to.be.a("string");
  });
}
